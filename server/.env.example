# ─── PostgreSQL (docker-compose db) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=communicator
DB_PASS=communicator_dev
DB_NAME=communicator_db

# Alternativa: usar una BD gestionada (Render/Neon/Supabase)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── App ────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ─── LiveKit (llamadas grupales) ────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Opcional ───────────────────────────────────────────────────
# DB_SSL=true          # activa SSL para PG gestionado
# VALIDATE_RESPONSES=false
# OPENAPI_STRICT=false
