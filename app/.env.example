# ──────────────────────────────────────────────────
# Communicator App - Configuración de Conexión
# ──────────────────────────────────────────────────
# Copia este archivo como .env y ajusta según tu modo de desarrollo.
#
# Modo USB (ADB reverse) — recomendado:
#   API_URL=http://localhost:3000/api
#   SOCKET_URL=http://localhost:3000
#   (requiere: adb reverse tcp:3000 tcp:3000)
#
# Modo WiFi — sin cable:
#   1. Obtén la IP local del servidor: ip a | grep inet
#   2. Reemplaza 192.168.X.X por la IP del servidor
#   API_URL=http://192.168.X.X:3000/api
#   SOCKET_URL=http://192.168.X.X:3000
# ──────────────────────────────────────────────────

API_URL=http://localhost:3000/api
SOCKET_URL=http://localhost:3000
EXPO_PROJECT_ID=your-expo-project-id
